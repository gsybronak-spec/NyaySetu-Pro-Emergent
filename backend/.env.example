# ============================================================
# NYAYSETU PRO BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# DO NOT COMMIT ACTUAL SECRETS TO REPOSITORY.
# Use this file as a reference when configuring Environment
# Variables in the Vercel Dashboard, Render Dashboard, or local .env.
# ============================================================

# ------------------------------------------------------------
# 1. CORE DATABASE (REQUIRED ON VERCEL, RENDER & LOCAL)
# ------------------------------------------------------------
# MongoDB Atlas Connection URI (TLS/SRV enabled)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB database name
DB_NAME=nyaysetu_pro

# ------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT & SECURITY (REQUIRED ON VERCEL & RENDER)
# ------------------------------------------------------------
# Set to "production" in Vercel/Render production deployments.
# In production, server enforces high-entropy JWT secrets and disables dev OTP.
ENVIRONMENT=production

# JWT signing secret (min 32 characters, recommended 64-char hex string)
JWT_SECRET=your-secure-random-64-character-hex-jwt-secret-here

# ------------------------------------------------------------
# 3. INITIAL SUPER ADMIN SEED (RECOMMENDED ON VERCEL & RENDER)
# ------------------------------------------------------------
# Super admin credentials created idempotently on startup if not present
ADMIN_SEED_EMAIL=admin@nyaysetupro.in
ADMIN_SEED_PASSWORD=your-super-admin-secure-password

# ------------------------------------------------------------
# 4. PAYMENTS & GATEWAYS (REQUIRED FOR LIVE RAZORPAY BILLING)
# ------------------------------------------------------------
# Razorpay Key ID (rzp_live_... for production, rzp_test_... for test)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Webhook Secret (for verifying HMAC-SHA256 signatures)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Razorpay API Base URL (defaults to https://api.razorpay.com)
RAZORPAY_API_BASE=https://api.razorpay.com

# ------------------------------------------------------------
# 5. AUTHENTICATION & OAUTH (OPTIONAL / AS NEEDED)
# ------------------------------------------------------------
# Firebase Project ID for Google/Firebase Auth token verification
FIREBASE_PROJECT_ID=nyaysetu-pro

# Google OAuth Client ID & Secret for web sign-in
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------
# 6. SMS / OTP PROVIDER (OPTIONAL)
# ------------------------------------------------------------
# SMS delivery mode: "console" (logs to stdout) or "twilio" / custom provider
SMS_PROVIDER=console
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------
# 7. CORS ORIGINS (OPTIONAL — DEFAULTS COVER PRODUCTION DOMAINS)
# ------------------------------------------------------------
# Comma-separated allowed frontend origins.
# Default already permits: https://nyaysetupro.in, https://www.nyaysetupro.in,
# https://*.vercel.app, and localhost regex.
CORS_ORIGINS=https://nyaysetupro.in,https://www.nyaysetupro.in
